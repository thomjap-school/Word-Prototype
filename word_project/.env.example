# Copier ce fichier vers .env (à la racine, à côté de docker-compose.yml)
# et générer une vraie valeur, par ex : openssl rand -hex 32
#
# Secret partagé entre les services backend et collab (docker-compose.yml)
# pour authentifier les appels internes collab -> backend (voir
# collab/server.js et server/app/security.py::verify_internal_secret).
INTERNAL_SECRET=

# Client ID OAuth 2.0 Google, partagé entre les services backend (vérification
# du token) et frontend (VITE_GOOGLE_CLIENT_ID, bouton "Se connecter avec
# Google") via docker-compose.yml. À créer dans Google Cloud Console.
GOOGLE_CLIENT_ID=
