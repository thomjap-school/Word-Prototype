# DATABASE_URL=sqlite:///./wordv2.db

# Utilisé seulement si tu lances le backend hors Docker Compose (uvicorn direct).
# Avec docker-compose, c'est le .env à la racine du projet qui fait foi pour
# les services backend ET collab (voir ../.env.example) — laisse cette ligne
# vide ou supprime-la dans ton .env local si tu es sur Docker Compose.
INTERNAL_SECRET=changeme-generate-with-openssl-rand-hex-32
